# Secrets / runtime data — never commit
config.yaml
/data/
*.db
*.db-wal
*.db-shm

# Go build outputs
/report-portal
/psp
*.exe
/dist/
/out/
/bin/

# Misc
.DS_Store
.env

# Default `go build` output (named after the directory)
/StockAnalysisPrediction-Report-Portal

# Local test sandbox
/local-build/

# Frontend dependencies — never commit
web/node_modules/

# Frontend build output: built by CI then go:embed'd. Keep the .gitkeep
# placeholder so `go build` compiles the embed even before the SPA is built.
internal/web/dist/*
!internal/web/dist/.gitkeep
# The release note the pipeline injects before `go build` (internal/version). Ignored for the same
# reason the web bundle above is: a tracked file the build overwrites makes the worktree dirty, and
# a binary built from a dirty worktree is stamped vcs.modified=true, which the release check refuses.
internal/version/notes/release.md
internal/version/notes/history.json

# Editor / tool directories
.idea/
.vscode/
.claude/
.codex/
.cursor/
CLAUDE.md
AGENTS.md
