# The coverage corpus and the shell probes are parsed inside a Linux container. A CRLF checkout
# would give awk a trailing \r on every field — turning tier "require\r" into an unknown tier and
# the gate's report into fiction — and would put \r on the probes' shebang line. Pin them to LF
# regardless of the checking-out platform's core.autocrlf.
scripts/font-coverage-corpus.txt text eol=lf
scripts/*.sh                     text eol=lf
Dockerfile*                      text eol=lf
docker-entrypoint.sh             text eol=lf
internal/appplatform/testdata/descriptor-corpus.json text eol=lf
internal/appplatform/contract/descriptor-v2.schema.json text eol=lf
internal/appplatform/descriptor_contract_generated.go text eol=lf
scripts/generate_app_contract.py text eol=lf
web/src/lib/descriptor-contract.generated.ts text eol=lf
web/src/lib/bridge-v2.ts text eol=lf
web/src/lib/bridge-v2.test.ts text eol=lf
internal/appplatform/testdata/publisher-signatures.json text eol=lf
internal/appplatform/contract/publisher-signature-v1.schema.json text eol=lf
scripts/generate_publisher_signature_vectors.mjs text eol=lf
