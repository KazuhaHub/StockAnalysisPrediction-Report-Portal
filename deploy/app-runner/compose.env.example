# The .env lines of a compose project that runs the app-runner service (doc 187). `app-runner host-setup --apply`
# prints the real ones for your host; it never writes this file. Values below are the defaults of a new host.
COMPOSE_PROFILES=app-runner
# One variable selects the Portal image and the app-runner image together, and they must come from the same release.
# Production pins a fixed tag; the default follows :latest.
PORTAL_VERSION=v2026.47.1
# Portal runs as the runner's controller UID and GID.
PORTAL_UID=41001
PORTAL_GID=41001
# The host side of Portal's read-only bind of the control directory, and the socket inside Portal's container.
RP_APP_RUNNER_CONTROL_DIR=/var/lib/portal-app-runner/control
RP_APP_RUNNER_SOCKET=/var/lib/portal-app-runner/control/runner.sock
RP_APP_RUNNER_CONTROLLER_UID=41001
RP_APP_RUNNER_CONTROLLER_GID=41001
